    "@fontsource/inter": "^5.2.8",
    "@sentry/astro": "^10.55.0",
    "@tailwindcss/vite": "^4.1.18",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.2.21",
    "@types/eslint": "^8.56.12",
    "@types/node": "^22.19.11",
